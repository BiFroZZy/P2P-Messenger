SERVER_PORT=":8080"

SECRET_KEY=your_secret_key

SHUTDOWN_TIMEOUT=30s

DB_URL="postgres://postgres:your_passwordh@localhost:5432/your_db?sslmode=disable"

JWT_EXP=86400

GET_USER='select user_id, user_name, user_login, user_password from messenger_users where user_login=$1'

GET_USER_BY_ID='select user_name, user_login, user_password, created_at from messenger_users where user_id=$1'

SET_USER='insert into messenger_users (user_id, user_name, user_login, user_password) values ($1, $2, $3, $4)'

DELETE_USER='delete from messenger_users where user_id = $1'